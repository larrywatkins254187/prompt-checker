{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Checker",
  "version": "0.2.0",
  "identifier": "com.promptchecker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Checker",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Review your AI coding prompts",
    "longDescription": "Collects your Claude Code and Codex CLI sessions into a local database and uses Claude to review how well you prompt.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQTY2MDk5NEVGQ0M3MDYKUldRR3gveE9tV0NtVW1OVmVhL3MxSklnOGZ5OU9xOXVhbENyR0t6Wm1JL0JYMUhBSWgreDcvTksK",
      "endpoints": [
        "https://github.com/larrywatkins254187/prompt-checker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
